{
  "welcomeFile": "app/bookshop/index.html",
  "routes": [
    {
      "source": "^/app/(.*)$",
      "target": "$1",
      "localDir": "resources",
      "cacheControl": "no-cache, no-store, must-revalidate"
    },
    {
      "source": "^/admin/(.*)$",
      "target": "/admin/$1",
      "destination": "bookstore-api",
      "csrfProtection": true
    },
    {
      "source": "^/user/(.*)$",
      "target": "/user/$1",
      "destination": "bookstore-api",
      "csrfProtection": true
    },
    {
      "source": "^/odata/v4/orders/(.*)$",
      "target": "/odata/v4/orders/$1",
      "destination": "orders-api",
      "csrfProtection": true
    },
    {
      "source": "^/odata/v4/reviews/(.*)$",
      "target": "/odata/v4/reviews/$1",
      "destination": "reviews-api",
      "csrfProtection": true
    },
    {
      "source": "^/rest/browse/(.*)$",
      "target": "/rest/browse/$1",
      "destination": "bookstore-api",
      "csrfProtection": true
    },
    {
      "source": "^/rest/reviews/(.*)$",
      "target": "/rest/reviews/$1",
      "destination": "reviews-api",
      "csrfProtection": true
    }
  ]
}
